.git
.github
.andrecomp
.pnpm-store
node_modules
**/node_modules
coverage
data
tmp
*.log
packages/andrecomp-runner/dist
packages/andrecomp-runner/runner/target
packages/andrecomp-runner/devtools
packages/andrecomp-runner/docs
packages/andrecomp-runner/examples
packages/andrecomp-runner/test
packages/andrecomp-runner/test-fixtures
packages/andrecomp-runner/test-support
packages/andrecomp-runner/**/*.md
packages/andrecomp-runner/**/*.spec.ts
packages/andrecomp-runner/**/*.spec.tsx
packages/andrecomp-runner/**/*.test.cjs
packages/andrecomp-runner/**/*.test.cts
packages/andrecomp-runner/**/*.test.js
packages/andrecomp-runner/**/*.test.jsx
packages/andrecomp-runner/**/*.test.mjs
packages/andrecomp-runner/**/*.test.mts
packages/andrecomp-runner/**/*.test.ts
packages/andrecomp-runner/**/*.test.tsx
packages/andrecomp-runner/runner/crates/*/tests
packages/andrecomp-runner/scripts/*-smoke.mjs
# Exceptions (last match wins): the image build re-runs the runner's
# generated-file drift checks, so their committed outputs and inputs must
# survive the slimming above. 2026-09-04: the *.md rule stripped the
# committed capability contract out of the context and every image build
# on master failed its drift check — .github/docker-context-checks.Dockerfile
# now guards this in PR CI.
!packages/andrecomp-runner/generated/**
# ACPX generation verifies these immutable release attestations as build inputs.
# Keep current declarations and historical identities while excluding other development fixtures.
!packages/andrecomp-runner/test
packages/andrecomp-runner/test/**
!packages/andrecomp-runner/test/fixtures
packages/andrecomp-runner/test/fixtures/**
!packages/andrecomp-runner/test/fixtures/copilot-profile-v16-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v17-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v18-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v18-claude-qualification-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v19-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v18-muse-historical-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v19-muse-historical-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v20-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v21-identity.json
!packages/andrecomp-runner/test-fixtures
packages/andrecomp-runner/test-fixtures/**
!packages/andrecomp-runner/test-fixtures/pi-acp
packages/andrecomp-runner/test-fixtures/pi-acp/**
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v18-identity.json
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v19-identity.json
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v20-identity.json
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v21-identity.json
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v22-identity.json
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v23-identity.json
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v24-identity.json
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v25-identity.json
!packages/andrecomp-runner/docs/capability-contract.md
# check:runner-workflow-traceability access()es every regression test the
# stress-traceability spec names — those are src/**/*.test.ts files, so
# they must survive the *.test.ts rule above.
!packages/andrecomp-runner/src/**/*.test.ts
!packages/andrecomp-runner/src/**/*.test.tsx

packages/grok-acp/bin

# The Copilot build-time identity gate reads these sanitized source declarations.
!packages/andrecomp-runner/test/fixtures/copilot-profile-v*-identity.json
# Grok's source identity is also an input to the image profile drift check.
!packages/andrecomp-runner/test/fixtures/grok-profile-v*-identity.json
# Images build their pinned Copilot assets instead of copying host binaries.
/packages/andrecomp-runner/provider-assets/
/server/provider-assets/
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v23-claude-qualification-identity.json
!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v26-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v19-claude-qualification-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v22-identity.json
!packages/andrecomp-runner/test/fixtures/copilot-profile-v23-identity.json

!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v24-claude-historical-identity.json

!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v27-identity.json

!packages/andrecomp-runner/test-fixtures/pi-acp/profile-v28-identity.json
